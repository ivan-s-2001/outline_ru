# Outline RU — локальная среда OSPanel
NODE_ENV=development
URL=http://outline.local
PORT=3000
DEFAULT_LANGUAGE=ru_RU
WEB_CONCURRENCY=1

# Сгенерируйте две разные строки по 64 hex-символа:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=__GENERATE_64_HEX__
UTILS_SECRET=__GENERATE_64_HEX__

# MariaDB из OSPanel
DATABASE_DIALECT=mariadb
DATABASE_HOST=127.0.0.1
DATABASE_PORT=3306
DATABASE_NAME=outline
DATABASE_USER=outline
DATABASE_PASSWORD=outline
DATABASE_CHARSET=utf8mb4

# Redis из OSPanel
REDIS_URL=redis://127.0.0.1:6379

# Локальное хранение
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=./data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# Локальный HTTP за reverse proxy OSPanel
FORCE_HTTPS=false
PROXY_HEADERS_TRUSTED=true

# Mailpit из OSPanel
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=outline@local.test
SMTP_REPLY_EMAIL=outline@local.test
SMTP_TLS_CIPHERS=
SMTP_SECURE=false

LOG_LEVEL=debug
RATE_LIMITER_ENABLED=false
