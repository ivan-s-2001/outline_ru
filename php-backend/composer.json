{
  "name": "outline/yii-backend",
  "description": "Yii API backend for the Outline-compatible MariaDB edition",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.2",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-pdo_mysql": "*",
    "firebase/php-jwt": "^6.11",
    "yiisoft/yii2": "^2.0.53",
    "yiisoft/yii2-bootstrap5": "^2.0.51",
    "yiisoft/yii2-redis": "^2.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5"
  },
  "autoload": {
    "psr-4": {
      "app\\": ""
    }
  },
  "autoload-dev": {
    "psr-4": {
      "app\\tests\\": "tests/"
    }
  },
  "scripts": {
    "lint": "@php tools/lint.php",
    "test": "@php vendor/bin/phpunit"
  },
  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    },
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ]
}
