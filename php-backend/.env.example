APP_ENV=prod
APP_DEBUG=0
APP_URL=http://outline.local
APP_NAME=Outline
COOKIE_VALIDATION_KEY=replace-with-random-string
JWT_SECRET=replace-with-at-least-32-random-characters

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=outline
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

REDIS_ENABLED=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=4

# Local OSPanel default. For HTTPS/LAN use wss://your-host/collaboration through a reverse proxy.
COLLABORATION_HOST=127.0.0.1
COLLABORATION_PORT=3010
COLLABORATION_URL=ws://127.0.0.1:3010/collaboration
COLLABORATION_INTERNAL_URL=http://127.0.0.1:3010
COLLABORATION_DB_POOL=8
COLLABORATION_DEBOUNCE_MS=3000
COLLABORATION_MAX_DEBOUNCE_MS=10000
COLLABORATION_TIMEOUT_MS=30000
SESSION_COOKIE_SECURE=0

# Leave empty to store files under php-backend/runtime/storage/attachments.
ATTACHMENT_STORAGE_PATH=
ATTACHMENT_MAX_BYTES=52428800
IMPORT_MAX_BYTES=10485760
