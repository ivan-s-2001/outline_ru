APP_ENV=prod
APP_DEBUG=0
APP_URL=http://outline.local
APP_NAME=Outline
COOKIE_VALIDATION_KEY=replace-with-random-string-at-least-32-characters
APP_SECRET=replace-with-independent-random-string-at-least-32-characters
JWT_SECRET=replace-with-at-least-32-random-characters

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=outline
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4

REDIS_ENABLED=1
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=4

# Local OSPanel default. For HTTPS/LAN use wss://your-host/collaboration through a reverse proxy.
COLLABORATION_HOST=127.0.0.1
COLLABORATION_PORT=3010
COLLABORATION_URL=ws://127.0.0.1:3010/collaboration
COLLABORATION_INTERNAL_URL=http://127.0.0.1:3010
COLLABORATION_DB_POOL=8
COLLABORATION_DEBOUNCE_MS=3000
COLLABORATION_MAX_DEBOUNCE_MS=10000
COLLABORATION_TIMEOUT_MS=30000
SESSION_COOKIE_SECURE=0

# Leave empty to store files under php-backend/runtime/storage/attachments.
ATTACHMENT_STORAGE_PATH=
ATTACHMENT_MAX_BYTES=52428800
IMPORT_MAX_BYTES=10485760

# OAuth 2 authorization-code / refresh-token lifetime.
OAUTH_ACCESS_TOKEN_TTL=3600
OAUTH_REFRESH_TOKEN_TTL=2592000

# Webhooks block private/local destinations by default. Enable only for trusted local development.
WEBHOOK_ALLOW_PRIVATE=0

# Production calendar REST API. Without a token vacation calculation falls back to Monday-Friday
# for dates that are not present in the local MariaDB cache.
PRODUCTION_CALENDAR_API_URL=https://production-calendar.ru/v2
PRODUCTION_CALENDAR_COUNTRY=ru
PRODUCTION_CALENDAR_REGION=
PRODUCTION_CALENDAR_TOKEN=
