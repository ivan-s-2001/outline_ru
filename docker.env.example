# Основные настройки
NODE_ENV=production
URL=http://localhost:3000
PORT=3000
DEFAULT_LANGUAGE=ru_RU
WEB_CONCURRENCY=1

# docker-init.bat автоматически заменяет эти значения случайными ключами.
SECRET_KEY=__SECRET_KEY__
UTILS_SECRET=__UTILS_SECRET__

# PostgreSQL и Redis из docker-compose.ru.yml
DATABASE_URL=postgres://outline:outline@postgres:5432/outline
PGSSLMODE=disable
REDIS_URL=redis://redis:6379

# Локальное хранение вложений в Docker volume
FILE_STORAGE=local
FILE_STORAGE_LOCAL_ROOT_DIR=/var/lib/outline/data
FILE_STORAGE_UPLOAD_MAX_SIZE=262144000

# Для локального HTTP. На сервере используйте HTTPS через обратный прокси
# и замените URL на публичный адрес.
FORCE_HTTPS=false
PROXY_HEADERS_TRUSTED=true

LOG_LEVEL=info
RATE_LIMITER_ENABLED=true
RATE_LIMITER_REQUESTS=1000
RATE_LIMITER_DURATION_WINDOW=60

# Для входа настройте хотя бы один способ авторизации.
#
# Вариант 1: OIDC
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_AUTH_URI=https://example.org/authorize
# OIDC_TOKEN_URI=https://example.org/token
# OIDC_USERINFO_URI=https://example.org/userinfo
# OIDC_LOGOUT_URI=
# OIDC_USERNAME_CLAIM=preferred_username
# OIDC_DISPLAY_NAME=Войти через SSO
# OIDC_SCOPES=openid profile email
#
# Вариант 2: почта и SMTP
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=outline@example.org
# SMTP_REPLY_EMAIL=outline@example.org
# SMTP_TLS_CIPHERS=
# SMTP_SECURE=false
