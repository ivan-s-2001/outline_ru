APP_ENV=prod
APP_DEBUG=0
APP_URL=http://outline.local
APP_NAME=Outline PHP
COOKIE_VALIDATION_KEY=replace-with-random-64-character-value

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=outline_php
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DATABASE_URL=mysql://root:@127.0.0.1:3306/outline_php

REDIS_ENABLED=0
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DATABASE=4
REDIS_URL=redis://127.0.0.1:6379/4

COLLABORATION_ENABLED=1
COLLABORATION_HOST=127.0.0.1
COLLABORATION_PORT=3001
COLLABORATION_URL=ws://outline.local/collaboration
COLLABORATION_SECRET=replace-with-a-separate-random-secret-at-least-32-characters

MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM=outline@local.test
